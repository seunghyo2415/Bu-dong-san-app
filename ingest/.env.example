# 이 파일을 복사해 .env 로 저장하고 값을 넣으세요. (.env 는 GitHub 에 올라가지 않아요)

# 공공데이터포털 → 마이페이지 → 개발계정 → 일반 인증키 (Decoding)
PUBLIC_DATA_KEY=

# 카카오 개발자 → 내 애플리케이션 → 앱 키 → REST API 키 (단지 좌표 만들 때 사용)
KAKAO_REST_KEY=

# Supabase → Project Settings → API → Project URL / service_role 키 (⚠️ 절대 앱·GitHub에 넣지 말 것)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# (선택) Supabase 대신 Postgres 에 직접 넣을 때
# DATABASE_URL=postgres://...
